<?xml version="1.0" encoding="utf-8"?>
<!-- Dane aplikacji (sesja zaszyfrowana kluczem z Android Keystore) nie są kopiowane do chmury ani na inne urządzenie. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
