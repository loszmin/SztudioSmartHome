# Sztudio Smart Home – reverse proxy: HTTPS dla panelu, REST API i WebSocket (WSS).

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Dziennik bez parametrów adresu ($uri zamiast $request) – token WebSocket (?token=) nie trafia do logów.
log_format sztudio '$remote_addr [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent';

server {
    listen 80;
    server_name _;
    access_log /var/log/nginx/access.log sztudio;

    # Jedyny zasób dostępny po HTTP: publiczny certyfikat lokalnego urzędu, do instalacji na urządzeniach.
    location = /sztudio-ca.crt {
        root /certs;
        default_type application/x-x509-ca-cert;
        add_header Content-Disposition 'attachment; filename="sztudio-ca.crt"';
    }

    location / {
        return 301 https://$host:${SZTUDIO_HTTPS_PORT}$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;
    access_log /var/log/nginx/access.log sztudio;

    ssl_certificate     /certs/server.crt;
    ssl_certificate_key /certs/server.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_tickets off;

    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 1m;
    server_tokens off;

    include /etc/nginx/snippets/security-headers.conf;

    location /api/ {
        proxy_pass http://core:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Test połączenia i odczyt profili ONVIF mogą trwać kilkadziesiąt sekund.
        proxy_read_timeout 90s;
    }

    location /ws/ {
        proxy_pass http://core:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 1h;
    }

    # Service Worker i manifest zawsze świeże – inaczej panel nie zobaczy aktualizacji.
    location ~* ^/(sw\.js|registerSW\.js|manifest\.webmanifest|index\.html)$ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
