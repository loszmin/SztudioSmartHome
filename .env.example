# ---------- Docker Compose (Sztudio Core + PostgreSQL + panel) ----------
# Skopiuj ten plik do .env i ustaw własne wartości. Pliku .env nie umieszczaj w repozytorium.

# Hasło bazy danych PostgreSQL (tylko litery i cyfry – trafia do adresu połączenia).
POSTGRES_PASSWORD=
# Sekret Core (min. 32 znaki). Służy do podpisu tokenów i szyfrowania haseł urządzeń –
# jego zmiana unieważnia sesje i uniemożliwia odczyt zapisanych haseł urządzeń.
# Wygeneruj: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SZTUDIO_SECRET_KEY=
# Konto administratora tworzone przy pierwszym uruchomieniu (gdy baza nie ma użytkowników).
SZTUDIO_ADMIN_USERNAME=admin
SZTUDIO_ADMIN_PASSWORD=
# Port panelu na hoście.
SZTUDIO_HTTP_PORT=8080
# production | development (development włącza /api/docs i pozwala załadować dane demonstracyjne).
SZTUDIO_ENVIRONMENT=production
# Dodatkowe originy CORS (np. serwer deweloperski Vite): http://localhost:5173
SZTUDIO_CORS_ORIGINS=

# ---------- Frontend (wartości domyślne przy budowaniu, opcjonalne) ----------
# Domyślny adres Sztudio Core. Pusty = ten sam adres, z którego serwowany jest panel.
VITE_CORE_URL=
# Domyślny adres go2rtc. Pusty = strumienie przez Sztudio Core (/go2rtc).
VITE_GO2RTC_URL=
# Domyślne źródło danych przy pierwszym uruchomieniu: demo | live
VITE_DEFAULT_MODE=demo
